{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "Genomic feature(s) related to the variant. NOTE: Although genes could also be referenced using these attributes, they have an independent section to allow direct queries.",
    "properties": {
        "location": {
            "$ref": "https://w3id.org/ga4gh/schema/vrs/1.3/vrs.json#/definitions/Location"
        },
        "aliases": {
            "description": "Aliases/synonyms of the genomic feature if available",
            "examples": [
                "TP53", 
                "BRCA1"
            ],
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "ontologyTerms": {
            "$ref": "https://raw.githubusercontent.com/ga4gh-beacon/beacon-v2/main/framework/src/common/ontologyTerm.json",
            "description": "Ontology terms of the genomic feature",
            "examples": [
                {
                    "id": "SO:0001623",
                    "label": "5 prime UTR variant"
                },
                {
                    "id": "GO:0048856",
                    "label": "anatomical structure development"
                }
            ]
        },
        "xrefs": {
            "description": "Cross-references of the genomic feature. CURIE format is recommended.",
            "examples": [
                "HGNC:11998", "UCSC:uc002ict.4"
            ],
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "featureId": {
            "description": "stable identifier of genomic feature, preferably in CURIE format (e.g. HGNC:11998, UCSC:uc002ict.4, ENSEMBL:ENSG00000141510)",
            "examples": [
                "HGNC:11998", "UCSC:uc002ict, ENSEMBL:ENSG00000141510"
            ],
            "type": "string"
        },
        "parent": {
            "description": "Parent of the genomic feature, used for hierarchical relationships",
            "examples": [
                "HGNC:11998", "UCSC:uc002ict.4"
            ],
            "type": "string"
        },
        "children": {
            "description": "Children of the genomic feature, used for hierarchical relationships",
            "examples": [
                "HGNC:11998", "UCSC:uc002ict.4"
            ],
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "featureId"
    ],
    "title": "GenomicFeature",
    "type": "object"
}