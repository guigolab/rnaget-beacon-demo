{
    "$comment": "Synced from beacon-v2/models/json/.../genomicFeatures/defaultSchema.json (source YAML: models/src/.../genomicFeatures/defaultSchema.yml); genomicFeature $ref points at local genomicFeature.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": true,
    "description": "Schema for the genomic feature (e.g. gene, transcript or genomic interval...)",
    "properties": {
        "id": {
            "description": "Internal feature ID.",
            "examples": [
                "Feature12345"
            ],
            "type": "string"
        },
        "genomicFeature": {
            "type": "object",
            "$ref": "./genomicFeature.json"
        },
        "info": {
            "type": "object",
            "additionalProperties": true,
            "description": "Optional free-form metadata bag."
        },
        "matrixIds": {
            "items": {
                "type": "string"
            },
            "type": "array",
            "description": "list of matrix ids"
        }
    },
    "required": [
        "id"
    ],
    "title": "Genomic feature",
    "type": "object"
}
