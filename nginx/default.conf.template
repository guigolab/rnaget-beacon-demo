# Per-client rate / connection zones (http context via nginx templates).
limit_req_zone $binary_remote_addr zone=rnaget_api_req:10m rate=30r/s;
limit_conn_zone $binary_remote_addr zone=rnaget_api_conn:10m;
# GET probe cache (package is immutable between rebuilds).
proxy_cache_path /var/cache/nginx/rnaget levels=1:2 keys_zone=rnaget_api:10m
                 max_size=64m inactive=1h use_temp_path=off;

upstream beacon_api {
    server ${API_HOST}:${API_PORT};
}

server {

    gzip             on;
    gzip_types      text/tab-separated-values application/json text/css application/javascript;

    listen ${API_PORT};

    # Traefik / reverse proxies: rate-limit the real client, not the proxy hop.
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Beacon API under /rnaget-beacon/api/* → FastAPI /*
    location ${BASE_PATH}/api/ {
        rewrite ^${BASE_PATH}/api/(.*)$ /$1 break;

        limit_req zone=rnaget_api_req burst=150 nodelay;
        limit_req_status 429;
        limit_conn rnaget_api_conn 32;
        limit_conn_status 429;

        error_page 429 = @beacon_too_many;

        # Cache GETs that the upstream marks Cache-Control: public.
        proxy_cache rnaget_api;
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 5m;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on;
        proxy_ignore_headers Set-Cookie;
        add_header X-Cache-Status $upstream_cache_status always;

        proxy_pass http://beacon_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix ${BASE_PATH}/api;
        client_max_body_size 1m;
        proxy_read_timeout 120s;
    }

    location @beacon_too_many {
        default_type application/json;
        return 429 '{"meta":{"apiVersion":"v2.0.0","beaconId":"org.crg.rnaget-beacon","returnedSchemas":[],"returnedGranularity":"record","receivedRequestSummary":{}},"error":{"errorCode":429,"errorMessage":"Too many requests"}}';
    }

    # Static Next export (files live under /usr/share/nginx/html${BASE_PATH}/)
    location ${BASE_PATH}/ {
        root /usr/share/nginx/html;
        try_files $uri $uri.html $uri/index.html ${BASE_PATH}/index.html;
    }

    location = ${BASE_PATH} {
        return 302 ${BASE_PATH}/;
    }
}
